# Required
DATABASE_URL=postgresql://topik:topik@localhost:5432/topik
VALID_PASSCODE=your-secret-passcode

# CORS: comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,https://parkdoeui.github.io

# AI grading (use one of: Gemini API key, or Vertex AI project)
GEMINI_API_KEY=

# Vertex AI (optional, alternative to GEMINI_API_KEY)
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_CREDENTIALS_JSON=

# Model(s) for writing grading and transcription.
# Comma-separated fallback chain: tried in order, falling back on a 503 (overloaded).
WRITING_GRADER_MODEL=gemini-3.7-flash,gemini-3.6-flash
