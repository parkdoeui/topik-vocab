# Required
DATABASE_URL=postgresql://topik:topik@localhost:5432/topik
VALID_PASSCODE=your-secret-passcode

# CORS: comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,https://parkdoeui.github.io

# AI grading (use one of: Gemini API key, or Vertex AI project)
GEMINI_API_KEY=

# Vertex AI (optional, alternative to GEMINI_API_KEY)
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_CREDENTIALS_JSON=

# Model to use for writing grading and transcription
WRITING_GRADER_MODEL=gemini-2.5-pro
