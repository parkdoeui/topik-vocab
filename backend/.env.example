# Required
DATABASE_URL=postgresql://topik:topik@localhost:5432/topik
VALID_PASSCODE=your-secret-passcode

# CORS: comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,https://parkdoeui.github.io

# Public base URL for question assets referenced by image_url in writing-test JSON.
QUESTION_ASSET_BASE_URL=https://parkdoeui.github.io/topik-vocab/

# AI grading — use ONE of:
#   (a) Vertex AI (recommended; pro models available, billed to your GCP project), or
#   (b) a Gemini Developer API key (free tier: pro models unavailable).

# (a) Vertex AI. Locally, leave VERTEX_CREDENTIALS_JSON empty to use gcloud ADC.
#     In production (Railway), set VERTEX_CREDENTIALS_JSON to a service-account key JSON.
#     Note: gemini-3.1-pro-preview is served in the "global" location, not us-central1.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_CREDENTIALS_JSON=

# (b) Gemini Developer API key (leave VERTEX_PROJECT empty to use this)
GEMINI_API_KEY=

# Model for writing grading and transcription
WRITING_GRADER_MODEL=gemini-3.1-pro-preview
